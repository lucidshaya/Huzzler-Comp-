{
  "name": "huzzler-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.json && cp -R src/content/rubrics dist/content/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "paystack:setup": "tsx scripts/paystack-setup.ts",
    "batch:generate": "tsx scripts/batch-generate.ts",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^6.3.16",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
