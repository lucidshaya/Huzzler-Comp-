{
  "name": "huzzler-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/content/rubrics','dist/content/rubrics',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "paystack:setup": "tsx scripts/paystack-setup.ts",
    "batch:generate": "tsx scripts/batch-generate.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "vercel-build": "npm run build && node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').writeFileSync('public/robots.txt','User-agent: *\\nDisallow: /\\n')\"",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "jobs:drain": "tsx scripts/drain-jobs.ts",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "email:test": "tsx scripts/email-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "supabase": "^2.121.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "22.x"
  }
}
