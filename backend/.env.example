NODE_ENV=development
PORT=3001
APP_URL=http://localhost:4001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:4001

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: test keys in dev/staging, live keys only in production secrets
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_MONTHLY_PLAN_CODE=

# AI (added last). Leave empty: AI-graded work waits as "awaiting_ai" and is graded automatically
# once the key is set. AI_MOCK=true gives deterministic fake grades in development only.
ANTHROPIC_API_KEY=
# DeepSeek is used when its key is set (override with AI_PROVIDER=anthropic|deepseek).
DEEPSEEK_API_KEY=
AI_PROVIDER=
AI_MOCK=false
AI_MONTHLY_BUDGET_USD=500
USD_TO_NGN=1550

EMBEDDINGS_ENABLED=false
JUDGE0_URL=
JUDGE0_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Huzzler <fourtechonoliges@gmail.com>
# Production only: shared secret pg_cron uses to call POST /api/jobs/drain (openssl rand -hex 32)
CRON_SECRET=
REQUIRE_PHONE_OTP=false
ADMIN_REQUIRE_MFA=false

# Staff account created by `npm run seed`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=fourtechonoliges@gmail.com
SMTP_PASS=
SUPPORT_EMAIL=fourtechonoliges@gmail.com
